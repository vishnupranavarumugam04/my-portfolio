# MongoDB Database Connection (Atlas or local)
# If empty, server uses built-in JSON/in-memory persistence store fallback
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/portfolio?retryWrites=true&w=majority

# Port for backend Express server
PORT=7001

# Optional: GitHub Personal Access Token (for higher GitHub API rate limit: 5000 req/hr vs 60 req/hr)
GITHUB_TOKEN=

# Optional: Cloudinary configuration for image uploads (falls back to local/base64 storage if empty)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
